<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskMap.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DiskMap.Controls"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteKey" />
        <KeyboardAccelerator Key="Back" Invoked="OnBackKey" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKey" />
        <KeyboardAccelerator Key="Enter" Invoked="OnEnterKey" />
    </Page.KeyboardAccelerators>

    <Grid Padding="28,16,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <BreadcrumbBar x:Name="Crumbs" VerticalAlignment="Center" ItemClicked="OnCrumbClicked">
                <BreadcrumbBar.Resources>
                    <x:Double x:Key="BreadcrumbBarItemThemeFontSize">20</x:Double>
                    <x:Double x:Key="BreadcrumbBarChevronFontSize">13</x:Double>
                    <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                </BreadcrumbBar.Resources>
            </BreadcrumbBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpButton" Click="OnUp" ToolTipService.ToolTip="Up one level (Backspace)">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <ToggleButton x:Name="GrowthToggle" Click="OnGrowthToggled" IsChecked="True" ToolTipService.ToolTip="Show what changed since the last scan">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE9D2;" />
                        <TextBlock Text="Growth" />
                    </StackPanel>
                </ToggleButton>
                <Button Click="OnRescan" ToolTipService.ToolTip="Scan the drive again">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearSelectionButton" Click="OnClearSelection" Content="Clear selection" Visibility="Collapsed" />
                <Button x:Name="DeleteButton" Click="OnDeleteSelection" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock x:Name="DeleteText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="6" />
        </ScrollViewer>

        <Border
            x:Name="FilterBar"
            Grid.Row="2"
            Padding="16,6,6,6"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FilterText" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OnSelectMatches" Content="Select all matches" />
                <Button Grid.Column="2" Click="OnClearFilter" Content="Clear filter" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="288" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MapHost">
                <controls:TreemapControl x:Name="Map" />
                <StackPanel
                    x:Name="ScanOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Visibility="Collapsed">
                    <ProgressRing Width="44" Height="44" IsActive="True" />
                    <TextBlock x:Name="ScanText" HorizontalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                    <ProgressBar x:Name="ScanBar" Width="300" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Details" Padding="16" Spacing="12" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource SecondaryCaptionStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="StatusRight"
                Grid.Column="1"
                Style="{StaticResource SecondaryCaptionStyle}"
                TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</Page>
