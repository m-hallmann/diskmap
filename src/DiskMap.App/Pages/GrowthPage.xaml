<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DiskMap.Pages.GrowthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DiskMap.Pages">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,16,28,28" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="What grew" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource SecondaryCaptionStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ClearButton" Click="OnClear" Content="Clear selection" Visibility="Collapsed" />
                    <Button x:Name="DeleteButton" Click="OnDelete" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock x:Name="DeleteText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16,14" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="UsedCaption" Style="{StaticResource SecondaryCaptionStyle}" />
                        <TextBlock x:Name="UsedText" Style="{StaticResource BigNumberStyle}" />
                        <TextBlock x:Name="UsedNote" Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16,14" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="FreeCaption" Style="{StaticResource SecondaryCaptionStyle}" />
                        <TextBlock x:Name="FreeText" Style="{StaticResource BigNumberStyle}" />
                        <TextBlock x:Name="LimitText" Style="{StaticResource SecondaryCaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16,14" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Free space, last 30 days" />
                        <Canvas x:Name="Spark" Grid.Row="1" Height="56" SizeChanged="OnSparkSizeChanged">
                            <Line x:Name="SparkLimit" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeDashArray="4,3" StrokeThickness="1" />
                            <Polyline x:Name="SparkLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeLineJoin="Round" StrokeThickness="2" />
                        </Canvas>
                        <TextBlock x:Name="SparkEmpty" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionStyle}" Text="Not enough history yet. The tray helper records free space every hour." Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Padding="16,12,16,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryCaptionStyle}" Text="Folder" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SecondaryCaptionStyle}" Text="Change" />
                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource SecondaryCaptionStyle}" Text="Size now" />
                    </Grid>
                    <ListView x:Name="Rows" Padding="0,0,0,8" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GrowthRow">
                                <Grid Padding="0,10" ColumnSpacing="12" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                        ToolTipService.ToolTip="Select to delete" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <Border Width="12" Height="12" VerticalAlignment="Center" Background="{x:Bind Swatch}" CornerRadius="3" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                        <Grid Width="78">
                                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind DeltaText}" TextAlignment="Right" Visibility="{x:Bind UpVisibility}" />
                                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind DeltaText}" TextAlignment="Right" Visibility="{x:Bind DownVisibility}" />
                                        </Grid>
                                        <Grid Width="120" Height="6" VerticalAlignment="Center" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" CornerRadius="3">
                                            <Border Width="{x:Bind BarWidth}" HorizontalAlignment="Left" Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="3" Visibility="{x:Bind UpVisibility}" />
                                            <Border Width="{x:Bind BarWidth}" HorizontalAlignment="Left" Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="3" Visibility="{x:Bind DownVisibility}" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind SizeText, Mode=OneWay}" TextAlignment="Right" />
                                    <Button
                                        Grid.Column="4"
                                        Padding="6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="{x:Bind ShowInMap}"
                                        IsEnabled="{x:Bind CanShow, Mode=OneWay}"
                                        ToolTipService.ToolTip="Show in the map">
                                        <FontIcon FontSize="14" Glyph="&#xECA5;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Margin="16,8,16,20" Style="{StaticResource SecondaryCaptionStyle}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
